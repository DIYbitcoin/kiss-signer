#!/bin/sh
# Refuse a push to main while the documentation pictures trail the screens.
#
# THE ONE THING CI CANNOT TELL YOU IN TIME. check_docs_fresh is advisory on
# develop and --strict on the way to main, which is correct: a stale picture
# only matters where it ships. The cost of learning that from CI is the whole
# point of this file. The gate runs as the FIRST step of the release job, so a
# stale stamp skips the build entirely and the run goes red -- on main, in
# public, on the branch whose readme invites people to rebuild and compare the
# hashes. The push cannot be taken back; only a second commit can answer it.
#
# So this is not the old pre-push hook that ran the whole suite and held every
# push for three minutes behind a UI with nowhere to print why. It runs one
# check, in about fifty milliseconds, and only when the ref being pushed is
# main. Push develop as often as you like and this hook says nothing.
#
# If it refuses: bash tools/gen_docs_shots.sh, then commit what moves. Often
# nothing moves but the stamp, because the commit that changed a screen did not
# change a screen any picture shows -- and that is still the fix, because the
# stamp is what the gate reads.
#
# To push anyway, --no-verify. That is the right call exactly once: when you
# know the release job will fail and you want it to.
set -e
cd "$(git rev-parse --show-toplevel)"

pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] && pushing_main=1
done
[ "$pushing_main" = 1 ] || exit 0

if ! python3 tools/check_docs_fresh.py --strict; then
    echo
    echo "pre-push: refusing to push main with stale documentation pictures."
    echo "          bash tools/gen_docs_shots.sh, then commit what moves."
    echo "          To push anyway: git push --no-verify"
    exit 1
fi
