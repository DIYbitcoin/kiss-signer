#!/bin/sh
# Before any ref reaches the remote, check names, identities and new commits.
# Keep the existing main-branch documentation freshness check as a second gate.
# This hook cannot intercept direct API calls; those require the review manifest.
set -e
cd "$(git rev-parse --show-toplevel)"

# Read once: both the publication guard and the existing release check need it.
refs=$(cat)
printf '%s\n' "$refs" | python3 tools/hooks/publication_guard.py push "${1:?missing remote}"
pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] && pushing_main=1
done <<EOF
$refs
EOF
[ "$pushing_main" = 1 ] || exit 0

if ! python3 tools/check_docs_fresh.py --strict; then
    echo
    echo "pre-push: refusing to push main with stale documentation pictures."
    echo "          bash tools/gen_docs_shots.sh, then commit what moves."
    exit 1
fi
